  "bodyHtml": "<div id=\"mainShosai\">\r\n        \r\n        \r\n        \r\n\r\n        \r\n        <div class=\"BottomArea\">\r\n\r\n            <table class=\"containerWidth\">\r\n\t\t        <tr>\r\n\t\t            <td style=\"text-align:left;\">\r\n\t\t                <h1 class=\"title\">令和8年熊本地震関連情報</h1>\r\n                        \r\n                        <div id=\"snsButtonArea\"></div>\r\n                        <div class=\"kijiSubInfo\">\r\n                            <div class=\"updDate\">最終更新日：<time datetime=\"2026-10-22T17:12:28+09:00\">2026年10月22日</time></div>\r\n                            \r\n                            \r\n                            <div id=\"kijiKengenArea\"></div>\r\n                            <div class=\"clear\"></div>\r\n                        </div>\r\n                        <div class=\"clear\"></div>\r\n\t\t                \t\t            \r\n\t\t                \r\n    \t\t        \r\n\t\t                <div class=\"danraku\" id=\"danraku1\" style=\"display:block;\"><p class=\"title\">令和8年熊本地震　関連情報　令和8年10月22日（17時00分現在）</p><h2 class=\"title\">被害を受けられた皆さまへ<br></h2><p><span class=\"wys_fs_l\">被災者支援ガイド『被災者支援のトリセツ』を開設しました</span></p><div tmptype=\"3\" class=\"wys_template wys_imgList wys_img1\"><ul class=\"unordered\"><li><a  href=\"https://hikawa-shien-torisetsu.jp/\" target=\"_blank\" rel=\"noopener noreferrer\"><img src=\"https://www.town.hikawa.kumamoto.jp/kiji0036768/3_6768_up_7hhax6py.png\" alt=\"被災者支援のトリセツ_令和8年熊本地震 氷川町の被災者支援まとめ\" title=\"\"></a></li></ul></div><p class=\"body\"><a  href=\"https://hikawa-shien-torisetsu.jp/\" target=\"_blank\">『被災者支援のトリセツ』を使ってみる<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\">（外部リンク）</a></p><p><br></p><h3 class=\"title\">藤本町長から町民の皆さまへ</h3><ul class=\"unordered\"><li><a  href=\"https://youtu.be/DobDmKJmwgs?si=gGOxmdd5tfYBZtnM\" target=\"_blank\">令和8年10月18日（日曜日）<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\">（外部リンク）</a></li><li><a  href=\"https://youtu.be/6PNVVwPltaM?si=793dwW1MH3Ivs1S4\" target=\"_blank\">令和8年10月5日（月曜日）<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\">（外部リンク）</a></li><li><a  href=\"https://youtu.be/Zxo8P5UFe5U?si=lrA-b8TQD4BS-n8S\" target=\"_blank\">令和8年9月21日（月曜日）<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\">（外部リンク）</a></li><li><a  href=\"https://youtu.be/tjPG3VfLZVE?si=xCAtVZqAgKPGkMN7\" target=\"_blank\">令和8年9月13日（日曜日）<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\">（外部リンク）</a></li><li><a  href=\"https://youtu.be/OyH4SFfQwtQ?si=n3tsGjAsgM8LxDMG\" target=\"_blank\">令和8年9月6日（日曜日）<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\">（外部リンク）</a></li><li><a  href=\"https://youtu.be/EhmmalD4YQM\" target=\"_blank\">令和8年8月28日（金曜日）<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\">（外部リンク）</a><span class=\"wys_fc_red\"><br></span></li><li><a  href=\"https://youtu.be/W5FDOxBxRv0?si=aedcbYwgSmmnq8ju\" target=\"_blank\">令和8年8月18日（火曜日）<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\">（外部リンク）</a></li><li><a  href=\"https://youtu.be/Y8ThUFiva1s?si=QzAuTCLnf6ZizF3n\" target=\"_blank\">令和8年8月11日（火曜日）<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\">（外部リンク）</a></li><li><a  href=\"https://youtu.be/y2kymnHJaqY?si=vFdkSbNROhU5mtMq\" target=\"_blank\">令和8年8月2日（日曜日）<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\">（外部リンク）<br><br></a></li></ul><div><h3 class=\"title\">り災・被災証明</h3></div><div><ul class=\"unordered\"><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036763/index.html\" target=\"_blank\">り災証明書（被災証明書）の発行について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"><br><br></a></li></ul></div><div><h3 class=\"title\">ごみ関連</h3></div><div><ul class=\"unordered\"><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036755/index.html\" target=\"_blank\">令和8年熊本地震に伴う災害ごみ仮置場への受入れについて</a><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036763/index.html\" target=\"_blank\"><img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036766/index.html\" target=\"_blank\">ごみステーションへのごみ出しについて（お願い）<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0032605/index.html\" target=\"_blank\">野焼きは禁止されています<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"><br><br></a></li></ul></div><div><h3 class=\"title\">上下水道・井戸</h3><ul class=\"unordered\"><li><a  href=\"https://seikatsu.yatsushiro.jp/\" target=\"_blank\">氷川町上水道について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\">（外部リンク）</a></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036769/index.html\" target=\"_blank\">氷川町下水道について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036775/index.html\" target=\"_blank\">給水車による応急給水について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a>&nbsp;</li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036798/index.html\" target=\"_blank\">令和8年熊本地震に伴う下水道使用料の減免について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></li><li><a  href=\"https://seikatsu.yatsushiro.jp/top/news/10189.html\" target=\"_blank\">水道の宅内配管工事コールセンターの開設について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\">（外部リンク）</a></li><li><span class=\"wys_fc_red\"><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036836/index.html\" target=\"_blank\">令和8年熊本地震で被災した井戸の応急修理について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></span></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036849/index.html\" target=\"_blank\">令和8年熊本地震による浄化槽被害調査について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a><span class=\"wys_fc_red\"><br><br></span></li></ul><h3 class=\"title\">避難所</h3><ul class=\"unordered\"><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036789/index.html\" target=\"_blank\">現在開設中の避難所<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036776/index.html\" target=\"_blank\">飲料・生活用品を配布しています<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a>&nbsp;</li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036779/index.html\" target=\"_blank\">母子避難所を開設しています<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036793/index.html\" target=\"_blank\">ペットと入れる避難所を開設しています<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036760/index.html\" target=\"_blank\">被災者の方がホテル等に避難できます<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"><br><br></a></li></ul><h3 class=\"title\">建物・住宅</h3><ul class=\"unordered\"><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036772/index.html\" target=\"_blank\">令和8年熊本地震に係る賃貸型応急住宅（みなし仮設）のお知らせ<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036786/index.html\" target=\"_blank\">令和8年熊本地震に係る建設型仮設住宅について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036771/index.html\" target=\"_blank\">令和8年熊本地震に係る住宅の応急修理のご案内<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036774/index.html\" target=\"_blank\">令和8年熊本地震に係る被災住宅の緊急修理（ブルーシート展張等）について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036783/index.html\" target=\"_blank\">【令和8年熊本地震】被災者生活再建支援金<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036833/index.html\" target=\"_blank\">【令和8年熊本地震】災害援護資金の貸付 <img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036794/index.html\" target=\"_blank\">令和8年熊本地震で被災した家屋等の解体・撤去について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a>&nbsp;<span class=\"wys_fc_red\">NEW</span></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036841/index.html\" target=\"_blank\">自ら解体を行った被災家屋等の解体・撤去費用について（自費解体）<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a>&nbsp;<span class=\"wys_fc_red\">NEW</span></li><li><span class=\"wys_fc_red\"><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036816/index.html\" target=\"_blank\">自宅敷地内への建設型応急住宅の設置について（令和8年熊本地震）<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></span></li><li><span class=\"wys_fc_red\"><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036818/index.html\" target=\"_blank\">住宅再建に向けた電話相談窓口『令和8年熊本地震住まいサポートダイヤル』のご案内<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></span></li><li><span class=\"wys_fc_red\"><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036825/index.html\" target=\"_blank\">令和8年熊本地震により被害を受けたエコキュートの修理窓口について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"><br></a></span></li><li><span class=\"wys_fc_red\"><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036860/index.html\" target=\"_blank\">【令和8年熊本地震】被災住宅相談会を開催します<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></span>&nbsp;<span class=\"wys_fc_red\">NEW</span></li><li><span class=\"wys_fc_red\"><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036859/index.html\" target=\"_blank\">【令和8年熊本地震】住宅金融支援機構の相談窓口を開設中です<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></span>&nbsp;<span class=\"wys_fc_red\">NEW</span></li></ul><br><h3 class=\"title\">シャワー・入浴・洗濯支援</h3><ul class=\"unordered\"><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036780/index.html\" target=\"_blank\">竜北福祉センターでの入浴について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"><br></a></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036838/index.html\" target=\"_blank\">宮原福祉センターでの入浴について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a><span class=\"wys_fc_red\"><br><br></span></li></ul><h3 class=\"title\">子育て世帯の方へ</h3><ul class=\"unordered\"><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036778/index.html\" target=\"_blank\">「一時保育」始めました<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036779/index.html\" target=\"_blank\">母子避難所を開設しています<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"><br><br></a></li></ul><h3 class=\"title\">農業者の方へ</h3></div><div><ul class=\"unordered\"><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036411/index.html\" target=\"_blank\">気象災害による農作物（農地）や農業施設・機械等の被災状況の記録について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036817/index.html\" target=\"_blank\">断水となっていた氷川大堰掛かりの農業用水の通水が再開しています<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></li><li><span class=\"wys_fc_red\"><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036826/index.html\" target=\"_blank\">令和8年熊本地震に対する農林水産省の「被災者の生活となりわい支援のためのパッケージ」の公表について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></span></li><li><span class=\"wys_fc_red\"><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036835/index.html\" target=\"_blank\">令和8年熊本地震に伴う営農再開に向けた支援事業のお知らせ<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></span>&nbsp;<span class=\"wys_fc_red\">NEW</span></li><li><span class=\"wys_fc_red\"><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036846/index.html\" target=\"_blank\">令和8年熊本地震営農再開支援事業に伴う事業要望調査の受付について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></span>&nbsp;<span class=\"wys_fc_red\">NEW</span></li><li><span class=\"wys_fc_red\"><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036857/index.html\" target=\"_blank\">令和8年熊本地震による「水田」の被害について（稲刈り後の被害確認）<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></span></li></ul></div><div><h3 class=\"title\">商工業者の方へ</h3><ul class=\"unordered\"><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036804/index.html\" target=\"_blank\">【氷川町商工会】令和8年熊本地震に係る中小企業・小規模事業者向け特別相談窓口の開設について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036805/index.html\" target=\"_blank\">【熊本県】令和8年熊本地震に関する中小企業者向け相談窓口の設置について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036806/index.html\" target=\"_blank\">【熊本県信用保証協会】令和8年熊本地震に係る緊急時短期資金保証制度等について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></li><li><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036808/index.html\" target=\"_blank\">セーフティネット保証4号(令和8年熊本地震分)について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a>&nbsp;<span class=\"wys_fc_red\">NEW</span></li><li><span class=\"wys_fc_red\"><a  href=\"https://www.town.hikawa.kumamoto.jp/kiji0036812/index.html\" target=\"_blank\">令和8年熊本地震の災害に伴う雇用調整助成金の特例措置について<img title=\"\" alt=\"別ウィンドウで開きます\" src=\"https://www.town.hikawa.kumamoto.jp/dynamic/common/images/newwin.gif\"></a></span></li><li