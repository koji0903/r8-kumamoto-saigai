  "bodyHtml": "<div id=\"mainShosai\">\n        \n        \n        \n\n        \n        <div class=\"BottomArea\">\n\n            <table class=\"containerWidth\">\n\t\t        <tr>\n\t\t            <td style=\"text-align:left;\">\n\t\t                <h1 class=\"title\">西原村公立保育所のあり方検討委員会の開催状況等について</h1>\n                        \n                        <div id=\"snsButtonArea\"></div>\n                        <div class=\"kijiSubInfo\">\n                            <div class=\"updDate\">最終更新日：<time datetime=\"2026-11-09T15:00:02+09:00\">2026年11月9日</time></div>\n                            \n                            \n                            <div id=\"kijiKengenArea\"></div>\n                            <div class=\"clear\"></div>\n                        </div>\n                        <div class=\"clear\"></div>\n\t\t                \t\t            \n\t\t                \n    \t\t        \n\t\t                <div class=\"danraku\" id=\"danraku1\" style=\"display:block;\"><div class=\"wys_indent\"><br></div><h2 class=\"title\">西原村公立保育所のあり方検討委員会について<br></h2><p class=\"title\">【設置の目的】<br>&nbsp; 本村における人口の増加、保育ニーズの増加、および公共施設の老朽化が進む中、持続可能で質の高い保育環境を確保するため、公立保育所の役割や適正配置、運営形態について専門的かつ多角的な視点から検討することとしました。<br><br></p><p class=\"title\">【構成メンバー概要】</p><p class=\"title\">　村議会議員、学識経験者、主任児童委員、公立保育所の保護者代表、村内の保育園の園長、役場職員</p><p class=\"title\"><br></p><p class=\"title\">【委員会設置要綱】<br></p><div tmptype=\"0\" class=\"wys_template wys_list\"><ul><li><p><a  href=\"https://www.vill.nishihara.kumamoto.jp/kiji0032046/3_2046_3571_up_et81szqm.pdf\" target=\"_blank\"><img src=\"https://www.vill.nishihara.kumamoto.jp/dynamic/common/images/icon/pdf.gif\" alt=\"\" title=\"\" style=\"vertical-align:middle;\">&nbsp;西原村公立保育所のあり方検討委員会設置要綱（PDF：78キロバイト）&nbsp;<img src=\"https://www.vill.nishihara.kumamoto.jp/dynamic/common/images/newwin.gif\" alt=\"別ウインドウで開きます\" title=\"\"></a></p></li></ul></div><p class=\"body\"><br></p><div tmptype=\"3\" class=\"wys_template wys_imgList wys_img1\"><ul><li><img src=\"https://www.vill.nishihara.kumamoto.jp/kiji0032046/3_2046_3572_up_kpzu36zz.jpeg\" alt=\"検討風景\" title=\"\"></li></ul></div><p class=\"body\"><br><br></p><h3 class=\"title\">これまでの会議内容について<br></h3><p class=\"title\">これまでに開催された各委員会の会議資料および議事要約は、下記のとおりです。</p><p class=\"title\">【第1回：令和8年2月19日（木曜日）開催】 　<br></p><div tmptype=\"0\" class=\"wys_template wys_list\"><ul><li><p><a  href=\"https://www.vill.nishihara.kumamoto.jp/kiji0032046/3_2046_3578_up_oaiotk0o.pdf\" target=\"_blank\"><img src=\"https://www.vill.nishihara.kumamoto.jp/dynamic/common/images/icon/pdf.gif\" alt=\"\" title=\"\" style=\"vertical-align:middle;\">&nbsp;会議資料（PDF：546.8キロバイト）&nbsp;<img src=\"https://www.vill.nishihara.kumamoto.jp/dynamic/common/images/newwin.gif\" alt=\"別ウインドウで開きます\" title=\"\"></a></p></li></ul></div><div tmptype=\"0\" class=\"wys_template wys_list\"><ul><li><p><a  href=\"https://www.vill.nishihara.kumamoto.jp/kiji0032046/3_2046_3612_up_lqvq3tpb.pdf\" target=\"_blank\"><img src=\"https://www.vill.nishihara.kumamoto.jp/dynamic/common/images/icon/pdf.gif\" alt=\"\" title=\"\" style=\"vertical-align:middle;\">&nbsp;第1回議事要約（PDF：653.3キロバイト）&nbsp;<img src=\"https://www.vill.nishihara.kumamoto.jp/dynamic/common/images/newwin.gif\" alt=\"別ウインドウで開きます\" title=\"\"></a><br></p></li></ul></div><p class=\"body\"><br></p><p class=\"body\">【第2回：令和8年10月1日（木曜日）開催】 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <br></p><div tmptype=\"0\" class=\"wys_template wys_list\"><ul><li><a  href=\"https://www.vill.nishihara.kumamoto.jp/kiji0032046/3_2046_3573_up_vrddwehe.pdf\" target=\"_blank\"><img src=\"https://www.vill.nishihara.kumamoto.jp/dynamic/common/images/icon/pdf.gif\" alt=\"\" title=\"\" style=\"vertical-align:middle;\">&nbsp;会議資料（PDF：8.39メガバイト）&nbsp;<img src=\"https://www.vill.nishihara.kumamoto.jp/dynamic/common/images/newwin.gif\" alt=\"別ウインドウで開きます\" title=\"\"></a></li></ul></div><div tmptype=\"0\" class=\"wys_template wys_list\"><ul><li><p><a  href=\"https://www.vill.nishihara.kumamoto.jp/kiji0032046/3_2046_3613_up_vjce6li8.pdf\" target=\"_blank\"><img src=\"https://www.vill.nishihara.kumamoto.jp/dynamic/common/images/icon/pdf.gif\" alt=\"\" title=\"\" style=\"vertical-align:middle;\">&nbsp;第2回議事要約（PDF：752.5キロバイト）&nbsp;<img src=\"https://www.vill.nishihara.kumamoto.jp/dynamic/common/images/newwin.gif\" alt=\"別ウインドウで開きます\" title=\"\"></a></p></li></ul></div><div tmptype=\"0\" class=\"wys_template wys_list\"><ul><li><p><a  href=\"https://www.vill.nishihara.kumamoto.jp/kiji0032046/3_2046_3614_up_d6z72akm.pdf\" target=\"_blank\"><img src=\"https://www.vill.nishihara.kumamoto.jp/dynamic/common/images/icon/pdf.gif\" alt=\"\" title=\"\" style=\"vertical-align:middle;\">&nbsp;中間答申（PDF：359.6キロバイト）&nbsp;<img src=\"https://www.vill.nishihara.kumamoto.jp/dynamic/common/images/newwin.gif\" alt=\"別ウインドウで開きます\" title=\"\"></a></p></li></ul></div><p class=\"body\"><br><br></p><p class=\"body\"><br><br></p><p class=\"body\"><br><br></p><p class=\"title\"><br></p><div class=\"clear\"></div></div>\n\t\t            </td>\n\t            </tr>\n            </table>      \n            \n        </div>\n        <div class=\"clear\"></div>\n    </div>",
