  "bodyHtml": "<span class=\"date\">��������2026ǯ10��15��</span>\n                  \n                  \n                  <div class=\"articleBox\">\n                    \n                    <div class=\"articleArea00\">\n<p>�����������ˤϡ����Ȥ��ü����������������������ʤɤǤ��Ժ߼���ɼ�Ȥ������٤��ߤ����Ƥ��ޤ������������ܻԤ���������Ѱ��񤫤�����ˡ������̾����Ͽ������פθ��դ�����Ƥ���ɬ�פ�����ޤ���</p><h4>�оݤȤʤ��</h4><p>���ܻԤ������̾������Ͽ����Ƥ��ꡢ������Ģ����äƤ����<strong><strong>&#65279;</strong></strong></p><h4>�����̾����Ͽ������</h4>\r\n�������οͤ�������������������ʤɤ��Ժ߼���ɼ�򤹤�ݤˡ�������ܿͤǤ��뤳�Ȥ���������ΤǤ������դ�������ͤϡ������̾���������̾����Ͽ������ȯ�ԺѤߤμԤȤ�����ܤ��졢�̾����ɼ���������ɼ�Τۤ��ˡ�����������������Ǥ���ɼ���Ǥ���褦�ˤʤ�ޤ���<br />�������������������ˡ����ɼ������Ǥ⡢��ɼ�κݤˡ������̾����Ͽ������פ��󼨤���ɬ�פ�����ޤ���<br /><h5>&nbsp;������ˡ</h5>\r\n<p>&nbsp;�����ν�����ܻԤ���������Ѱ���ء����(������͹��)���Ƥ���������<br />������Ф����������Ǥ�Ǥ��ޤ�������̾���ɬ���������ܿͤ����𤷤Ƥ���������<table class=\"commonTable\" summary=\"�����̾����Ͽ������θ��տ�����ɬ�פʤ��\"><caption style=\"text-align:left\">���տ�����ɬ�פʤ��</caption><tr><td>&nbsp;1�������̾����Ͽ��������տ�����</td><td><p><a  class=\"download\" href=\"https://www.city.kamiamakusa.kumamoto.jp/dl?q=127752_filelib_6c1f1884fbf1acb36b4c5f280ea30720.doc\" target=\"_blank\" rel=\"noopener noreferrer\">�����̾����Ͽ��������տ�����(WORD ��34KB)</a></p><p>����̾���ɬ�����𤷤Ƥ���������</p></td></tr><tr><td>&nbsp;2��������Ģ�μ̤���</td><td><p>&nbsp;���Υ����饦�ޤǤΤ����줫�ν����ź�դ��Ƥ���������</p><p>����������Ģ�μ̤�</p><p>����ɽ�桢��̿��ڡ�������̾���ڡ�������������ط��ڡ���</p><p>���������Ǥ���ݤξ�����(������Ģ������Ǥ��ʤ����)</p><p>��<a  class=\"download\" href=\"https://www.city.kamiamakusa.kumamoto.jp/dl?q=127753_filelib_79025fdf60d34b296e79c2b4a3bbe802.doc\" target=\"_blank\" rel=\"noopener noreferrer\">�����Ǥ���ݤξ�����(WORD ��30KB)</a></p><p>�����ۼ硢��Ĺ���ξ�����ɬ�פˤʤ�ޤ���</p><p>�����������½����ξ�����(�½��Τ���˹ҳ���������ξ��)</p></td></tr></table><p>�����ջ����<ul><li>�����̾����Ͽ�������ͭ�����¤�7ǯ�֤Ǥ������¤��ڤ�Ƥ�����ϡ����ٿ�����ɬ�פǤ���</li><li>�����̾����Ͽ�������ʶ���������ϡ�&nbsp;�������̾����Ͽ������ʶ���Ϸ������ϡפ���������Ѱ������Ф��Ƥ�����������ȯ�Ԥ��˾������ϡ����ξ�Ǻ��ٿ�����ɬ�פǤ���<br />��<a  class=\"download\" href=\"https://www.city.kamiamakusa.kumamoto.jp/dl?q=127754_filelib_abae1bfa2b48e16954d6ff6bd37883dd.doc\" target=\"_blank\" rel=\"noopener noreferrer\">�����̾����Ͽ������ʶ���Ϸ�������(WORD ��29KB)</a></li><li>�࿦�ʤɤ���ͳ�������̾����Ͽ���������פȤʤä����ϡ��������̾����Ͽ�������ֵ��ϡפ�ʻ���������̾����Ͽ���������������Ѱ���ˤ��ֵѤ���������<br />��<a  class=\"download\" href=\"https://www.city.kamiamakusa.kumamoto.jp/dl?q=127755_filelib_cbfd00468316c823b24ecc98ad67b8b8.doc\" target=\"_blank\" rel=\"noopener noreferrer\">�����̾����Ͽ�������ֵ���(WORD ��28KB)</a></li></ul>\r\n<h4>&nbsp;��ɼ��ˡ</h4>\r\n<p>�������̾����Ͽ������θ��դ�������ͤϡ��̾����ɼ���������ɼ�Τۤ��˰ʲ�����ɼ���Ǥ��ޤ���</p>\r\n<p>�ڻ�����Ǥ��Ժ߼���ɼ��<span style=\"color:#014dfe\"></span><table class=\"commonTable\" summary=\"�������ɼ�ξܺ�\"><caption style=\"text-align:left;color:#000000\">�������ɼ�ξܺ�</caption><tr><td style=\"color:#000000\">�оݼ�</td><td style=\"color:#000000\">���ȥ��5�ȥ�(�����ξ���30�ȥ�)�ʾ�������ξ��Ȱ��ǡ������̾����Ͽ������򤪻�������</td></tr><tr><td style=\"color:#000000\">�оݤ�����&nbsp;</td><td style=\"color:#000000\">����������������&nbsp;</td></tr><tr><td style=\"color:#000000\">��ɼ��ή��</td><td style=\"color:#000000\"><p>1�������ܿͤ�������Τ���Զ�Į¼��������Ѱ���˽и�������ɼ�ѻ�����ᤷ�ޤ���</p><p>2����ɼ�ѻ椬ľ�ܸ��դ���ޤ��Τǡ����ξ����ɼ���ޤ���</p><p>3��������λԶ�Į¼��������Ѱ��񤫤��ŷ�����������Ѱ�������פ���ޤ���</p></td></tr><tr><td style=\"color:#000000\">�����ɬ�פʤ��</td><td style=\"color:#000000\"><p>1��������(������λԶ�Į¼��������Ѱ���ˤƸ���)</p><p>2�������̾����Ͽ������</p><p>3��������Ģ&nbsp;</p></td></tr><tr><td style=\"color:#000000\">���ᡦ��ɼ����</td><td style=\"color:#000000\"><p>����θ���(��)�����������������������ޤ�</p><p>����ɼ�ѻ�����פ��֤˹��ʤ���礬����ޤ��Τǡ�������ɼ���Ƥ���������<br />�����ᡦ��ɼ�ˤĤ��Ƥϡ�������λԶ�Į¼��������Ѱ���˻����ˤ���ǧ����������</p></td></tr></table><p style=\"color:#000000\">��������Ǥ��Ժ߼���ɼ��<br />�����ȥ��20�ȥ�(�����ξ���30�ȥ�)�ʾ�������ξ��Ȱ��ϡ�����������֤��줿�Ժ߼���ɼ���ܾ�����ɼ���뤳�Ȥ��Ǥ��ޤ���<p style=\"color:#000000\">���ξ���ɼ��<br />�����Τ�ҹԤ�������ζȼ�������˾������������ϡ����ꤵ��Ƥ������������ɼ���ơ��ե������ߥ���Ѥ����������뤳�Ȥ��Ǥ��ޤ���(�оݤϽ��ı��İ������󡢻��ı��İ��̾����󡢺ǹ��Ƚ���Ƚ����̱�����˸¤�ޤ���)&nbsp;</p>",
