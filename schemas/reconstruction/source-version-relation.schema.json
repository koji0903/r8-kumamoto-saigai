{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r8-kumamoto-saigai.local/schemas/reconstruction/source-version-relation.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "previousSourceId", "nextSourceId", "relationType", "detectedAt", "notes"],
    "properties": {
      "id": {"type": "string", "pattern": "^source_version_relation_[a-z0-9_]+$"},
      "previousSourceId": {"type": "string"},
      "nextSourceId": {"type": "string"},
      "relationType": {"enum": ["revision", "replacement", "withdrawal"]},
      "detectedAt": {"$ref": "common.schema.json#/$defs/nullableDateTime"},
      "notes": {"type": ["string", "null"]}
    }
  }
}
